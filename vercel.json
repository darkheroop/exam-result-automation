{
  "version": 2,
  "regions": ["bom1"],
  "functions": {
    "api/index.js": {
      "maxDuration": 30,
      "memory": 512
    },
    "api/*.js": {
      "maxDuration": 30,
      "memory": 512
    }
  },
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api",
      "destination": "/api/index.js"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/admin/login",
      "destination": "/admin/login.html"
    },
    {
      "source": "/admin/admin.css",
      "destination": "/admin/admin.css"
    },
    {
      "source": "/admin/admin.js",
      "destination": "/admin/admin.js"
    },
    {
      "source": "/admin",
      "destination": "/admin/index.html"
    },
    {
      "source": "/admin/((?!admin\\.js|admin\\.css|login\\.html).*)",
      "destination": "/admin/index.html"
    },
    {
      "source": "/((?!api/|admin).*)",
      "destination": "/index.html"
    }
  ]
}
