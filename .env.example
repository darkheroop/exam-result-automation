# ==============================================================================
# Examination Result Retrieval & PDF Download Automation - Configuration
# ==============================================================================

# Server Configuration
PORT=5050
NODE_ENV=development

# Student Lookup API (resolves student number to username and password)
STUDENT_LOOKUP_API_URL=https://student-lookup-portal.vercel.app/api/lookup
STUDENT_LOOKUP_API_KEY=your_authorized_bearer_token

# Educational Portal URLs
PORTAL_LOGIN_URL=https://ai-edunova.abes.ac.in/#/auth/login
PORTAL_RESULTS_URL=https://ai-edunova.abes.ac.in/#/insync/dashboard/exam/semester-examination-result?examMpId=2&resultView=annual

# Browser Automation Settings
CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
HEADLESS=true
PAGE_TIMEOUT_MS=35000

# Session & Security Settings
SESSION_TTL_MS=600000
MAX_CONCURRENT_SESSIONS=10
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=30
